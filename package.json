{
  "name": "collab-editor-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"nodemon --exec ts-node src/index.ts --watch src\" \"ts-node src/ydoc/startYjs.ts\"",
    "dev:server": "nodemon --exec ts-node src/index.ts --watch src",
    "dev:yjs": "ts-node src/ydoc/startYjs.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dockerode": "^4.0.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "lib0": "^0.2.93",
    "mongoose": "^8.0.0",
    "socket.io": "^4.6.0",
    "ws": "^8.16.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.23",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
